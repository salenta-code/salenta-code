#!/bin/bash
# Salenta Harness – eigener Agent von Salenta Code (Node 18+). Code liegt in bin/harness/.
here="$(cd "$(dirname "$0")" && pwd -P)"
node_bin="$(command -v node || true)"
for c in /opt/homebrew/bin/node /usr/local/bin/node "$HOME/.volta/bin/node"; do [ -z "$node_bin" ] && [ -x "$c" ] && node_bin="$c"; done
[ -z "$node_bin" ] && { echo "Salenta Harness braucht Node.js (brew install node)" >&2; exit 127; }
exec "$node_bin" "$here/harness/cli.mjs" "$@"
