#!/bin/bash
# Grundausstattung für Salenta Code auf einem frischen Mac – läuft im Terminal, Schritt für Schritt, und wartet,
# wo Apple oder Homebrew eine Bestätigung brauchen. Aufruf: aos-setup [git brew gh node tmux claude codex gh-login]
set -u
want=("$@"); [ ${#want[@]} -eq 0 ] && want=(git brew gh node tmux claude codex gh-login)
has() { command -v "$1" >/dev/null 2>&1; }
wants() { for w in "${want[@]}"; do [ "$w" = "$1" ] && return 0; done; return 1; }
say() { printf '\n\033[1m→ %s\033[0m\n' "$*"; }
brewenv() { for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$b" ] && eval "$("$b" shellenv)" && return 0; done; return 1; }

# 1) Apple Command Line Tools (git, Compiler) – Apple zeigt dafür einen Dialog; wir warten, bis er durch ist
if ! xcode-select -p >/dev/null 2>&1; then
  say "Apple-Entwicklerwerkzeuge (Command Line Tools) installieren – bitte im Apple-Dialog „Installieren“ klicken. Ich warte."
  xcode-select --install >/dev/null 2>&1 || true
  for i in $(seq 1 360); do xcode-select -p >/dev/null 2>&1 && break; sleep 10; done
  if ! xcode-select -p >/dev/null 2>&1; then echo "✗ Command Line Tools sind noch nicht da. Bitte den Apple-Dialog abschließen und „Fehlendes installieren“ erneut starten."; exit 1; fi
  echo "✓ Command Line Tools installiert"
fi

# 2) Homebrew
if ! brewenv; then
  if wants brew || wants gh || wants node || wants tmux; then
    say "Homebrew installieren (Passwort-Abfrage von macOS ist normal)"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || { echo "✗ Homebrew-Installation abgebrochen."; exit 1; }
    brewenv || { echo "✗ Homebrew nicht gefunden."; exit 1; }
    # dauerhaft in die Shell – sonst fehlt brew beim nächsten Terminal
    for rc in "$HOME/.zprofile" "$HOME/.bash_profile"; do grep -q 'brew shellenv' "$rc" 2>/dev/null || printf '\neval "$(%s shellenv)"\n' "$(command -v brew)" >> "$rc"; done
    echo "✓ Homebrew installiert"
  fi
fi

# 3) Pakete
pk=(); wants gh && ! has gh && pk+=(gh); wants node && ! has node && pk+=(node); wants tmux && ! has tmux && pk+=(tmux)
if [ ${#pk[@]} -gt 0 ]; then say "Installieren: ${pk[*]}"; brew install "${pk[@]}" || { echo "✗ brew install fehlgeschlagen."; exit 1; }; fi

# 4) Claude Code
if wants claude && ! has claude; then
  say "Claude Code installieren"
  curl -fsSL https://claude.ai/install.sh | bash || { echo "✗ Claude Code konnte nicht installiert werden."; exit 1; }
  export PATH="$HOME/.local/bin:$PATH"
fi

# 5) Codex (optional – scheitert nicht laut)
if wants codex && ! has codex; then
  say "Codex installieren"
  brew install codex 2>/dev/null || (has npm && npm install -g @openai/codex) || echo "· Codex übersprungen (später: brew install codex)"
fi

# 6) GitHub anmelden
if wants gh-login && has gh && ! gh auth status >/dev/null 2>&1; then
  say "Bei GitHub anmelden (öffnet den Browser)"
  gh auth login --web --git-protocol https && gh auth setup-git
fi

echo; echo "✓ Fertig – zurück zu Salenta Code und „Erneut prüfen“."
