             "supabase status", "supabase functions serve", "shopify theme check", "shopify theme dev", "jq", "curl -s",
             "mkdir", "touch", "cp ", "mv ",
             # übliche Prüf- und Bau-Befehle, die im Projekt bleiben (wie Claude Code sie ständig nutzt)
             "npx next ", "npx playwright test", "npx vite", "npx biome", "npx turbo", "turbo ", "npx astro", "npx svelte-check",
