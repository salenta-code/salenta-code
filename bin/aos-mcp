sys.path.insert(0, HERE)
ROOT = os.path.abspath(os.environ.get("AOS_HOME") or os.path.join(HERE, ".."))
DATA = os.path.join(ROOT, "data")

import importlib.machinery  # noqa: E402
import importlib.util  # noqa: E402

_loader = importlib.machinery.SourceFileLoader("aos_cli", os.path.join(HERE, "aos"))
aos = importlib.util.module_from_spec(importlib.util.spec_from_loader("aos_cli", _loader))
_loader.exec_module(aos)

