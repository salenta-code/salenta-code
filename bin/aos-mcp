SAFE_CMDS = ("ls", "cat", "head", "tail", "wc", "grep", "rg", "find", "pwd", "echo", "which", "file", "sed -n", "awk",
             "git status", "git diff", "git log", "git show", "git branch", "git fetch", "git add", "git commit", "git stash",
             "git checkout -b", "git switch", "npm test", "npm run", "npm ci", "npm install", "pnpm", "yarn", "npx tsc",
             "npx eslint", "npx prettier", "npx vitest", "npx jest", "tsc", "node ", "python3 ", "python ", "pytest",
