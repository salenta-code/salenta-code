#!/usr/bin/env python3
"""Salenta Code als MCP-Server (stdio) – damit Claude Code, Codex und Junie das OS sehen und steuern können.

Installieren:
  claude mcp add --scope user salenta-os -- python3 "$HOME/Salenta Code/bin/aos-mcp"
  codex mcp add salenta-os -- python3 "$HOME/Salenta Code/bin/aos-mcp"

Daten: data/tasks.json (Aufgaben), data/status.json (schreibt die App: Agents, Termine, Mail, Integrationen),
data/commands.jsonl (Befehle an die App: Agent starten, Seite öffnen, Benachrichtigen).
"""
import datetime as dt
import json
import os
import sys
import time
import uuid

