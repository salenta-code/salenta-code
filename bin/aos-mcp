             "diff ", "tree", "du ", "stat ", "basename", "dirname", "realpath", "date", "test ", "[ ")
RISKY_CMDS = ("git push", "push --force", "rm ", "rm\t", "sudo", "supabase db push", "supabase db reset", "supabase functions deploy",
              "vercel --prod", "vercel deploy", "shopify theme push", "shopify theme publish", "npm publish", "drop table",
              "truncate", "delete from", "curl -x post", "curl -x delete", "curl -d", "chmod -r", "kill ", "launchctl",
              "> /dev", "mkfs", "dd ", "git reset --hard", "git clean")


def bash_needs_approval(cmd):
    c = " ".join(str(cmd).lower().split())
    if any(r in c for r in RISKY_CMDS):
        return True
    parts = [p.strip() for p in c.replace("&&", ";").replace("||", ";").replace("|", ";").split(";") if p.strip()]
    for p in parts:
        if p.startswith("cd ") or p == "cd":
            continue
        if not any(p.startswith(s) for s in SAFE_CMDS):
            return True
    return False


def needs_approval(tool, inp):
    """Lesende Tools laufen direkt, alles was verändert oder verschickt, fragt den Nutzer."""
    name = tool.split("__")[-1].lower()
    if tool == "Bash":
        return bash_needs_approval((inp or {}).get("command", ""))
    if tool.startswith("mcp__salenta-os__") and name not in ("agent_starten",):
        return False
    if control_scope(tool):
        # Steuerung ist freigegeben (siehe freigabe): Schauen, Klicken und Tippen sind normale Arbeit –
        # außer es geht ums Absenden, Kaufen, Bezahlen, Löschen, Posten.
        if any(k in name for k in ("file_upload", "evaluate", "run_code", "install", "javascript")):
            return True
        what = " ".join(str(v) for v in (inp or {}).values()).lower()
        acts = ("click", "press", "key", "type", "fill", "form", "submit", "computer", "batch")
        if any(a in name for a in acts) and any(k in what for k in RISKY_WORDS):
            return True
        return False
    if name.startswith(("get", "list", "search", "read", "find", "fetch", "query", "lookup", "describe")):
        return False
    if any(k in name for k in WRITE_HINTS):
        return True
    return not any(k in name for k in READ_HINTS)


def project_root(start):
    d = os.path.abspath(start or ".")
    while d and d != "/":
        if os.path.exists(os.path.join(d, ".git")):
            return d
        d = os.path.dirname(d)
    return None


def load_block_rules():
    """Blockier-Regeln: data/rules.json (alle Projekte) + .salenta-os.json / .aos.json im Repo des Agents."""
    rules = []
    paths = [os.path.join(DATA, "rules.json")]
    root = project_root(os.environ.get("PWD") or os.getcwd())
    if root:
        paths += [os.path.join(root, n) for n in (".salenta-os.json", ".aos.json")]
    for path in paths:
        try:
            with open(path, encoding="utf-8") as f:
                j = json.load(f)
        except Exception:
            continue
        rules += j.get("blocken") or j.get("block") or []
    return rules


def rule_check(tool, inp):
    """('block'|'ask'|None, Grund) – greift auch im Auto-Modus."""
    import re
    if tool == "Bash" and isinstance(inp, dict):
        text = ("bash " + str(inp.get("command", ""))).lower()
    else:
        text = (tool + " " + json.dumps(inp or {}, ensure_ascii=False)).lower()
    for r in load_block_rules():
        pat = (r.get("muster") or "").strip()
        if not pat:
            continue
        try:
            if not re.search(pat, text, re.I):
                continue
            unless = (r.get("ausser") or "").strip()
            if unless and re.search(unless, text, re.I):
                continue
        except re.error:
            continue
        return ("ask" if r.get("fragen") else "block"), (r.get("grund") or pat)
    return None, ""


BROWSER_SERVERS = ("browser", "playwright", "chrome", "puppeteer", "browserbase", "stagehand")
COMPUTER_SERVERS = ("computer", "desktop-control", "mac-control", "macos-control")


def control_scope(tool):
    """'browser' oder 'computer', wenn das Tool deinen Browser bzw. deinen Mac steuert – sonst None."""
    parts = tool.split("__")
    if len(parts) < 3 or parts[0] != "mcp":
        return None
    server = parts[1].lower()
    if any(k in server for k in COMPUTER_SERVERS):
        return "computer"
    if any(k in server for k in BROWSER_SERVERS):
        return "browser"
    return None


def grant_active(scope):
    """Hast du die Steuerung (Browser/Computer) gerade freigegeben? data/approvals/grants.json, gesetzt von der App."""
    try:
        with open(os.path.join(DATA, "approvals", "grants.json"), encoding="utf-8") as f:
            g = json.load(f)
        return time.time() < float(g.get(scope) or 0)
    except Exception:
        return False


RISKY_WORDS = ("senden", "send", "absenden", "submit", "kaufen", "bestellen", "buy", "order", "bezahlen", "zahlen", "pay",
               "checkout", "kasse", "löschen", "loeschen", "delete", "posten", "post", "veröffentlichen", "publish",
               "bestätigen", "confirm", "abschließen", "vertrag", "passwort", "password", "überweis", "transfer")


def auto_mode():
    """Auto-Modus aus data/approvals/mode.json (setzt die App)."""
    try:
        with open(os.path.join(DATA, "approvals", "mode.json"), encoding="utf-8") as f:
            m = json.load(f)
    except Exception:
        return False
    if not m.get("auto"):
        return False
    bis = m.get("bis")
    return bis is None or time.time() < float(bis)


def log_auto(tool, inp):
    d = os.path.join(DATA, "approvals")
    os.makedirs(d, exist_ok=True)
    detail = " · ".join(f"{k}: {str(v)[:120]}" for k, v in list((inp or {}).items())[:3])
    with open(os.path.join(d, "auto.log"), "a", encoding="utf-8") as f:
        f.write(json.dumps({"tool": tool, "detail": detail, "zeit": time.time()}, ensure_ascii=False) + "\n")


def ask_user(tool, inp, timeout=900):
    d = os.path.join(DATA, "approvals")
    os.makedirs(d, exist_ok=True)
    rid = uuid.uuid4().hex[:12]
    with open(os.path.join(d, f"req-{rid}.json"), "w", encoding="utf-8") as f:
        json.dump({"id": rid, "tool": tool, "input": inp, "zeit": time.time()}, f, ensure_ascii=False)
    dec_path = os.path.join(d, f"dec-{rid}.json")
    end = time.time() + timeout
    while time.time() < end:
        if os.path.exists(dec_path):
            try:
                with open(dec_path, encoding="utf-8") as f:
                    dec = json.load(f)
                return bool(dec.get("allow")), dec.get("message") or ""
            except Exception:
                pass
        time.sleep(1)
    return False, "Keine Antwort innerhalb von 15 Minuten."


def delegation_result(cid, wait=0):
    """Wartet (optional) auf das Ende eines delegierten Auftrags und liefert das Ergebnis aus der Mitschrift."""
    end = time.time() + wait
    path = os.path.join(DATA, "delegations", f"{cid}.json")
    while True:
        info = None
        try:
            with open(path, encoding="utf-8") as f:
                info = json.load(f)
        except Exception:
            pass
        if info:
            mid = info.get("mission")
            rec = None
            try:
                with open(os.path.join(DATA, "missions.json"), encoding="utf-8") as f:
                    rec = next((m for m in json.load(f) if m.get("id") == mid), None)
            except Exception:
                pass
            if rec and rec.get("ended"):
                text = ""
                try:
                    text = open(info.get("log", ""), encoding="utf-8", errors="ignore").read()
                except Exception:
                    pass
                import re as _re
                text = _re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", text)
                return {"id": cid, "status": "fertig" if rec.get("ok") else "abgebrochen", "ordner": info.get("ordner"),
                        "ergebnis": text[-6000:]}
        if time.time() >= end:
            return {"id": cid, "status": "läuft" if info else "startet", "hinweis": "Noch nicht fertig – später ergebnis(id) aufrufen."}
        time.sleep(3)


def short_task(t):
    return {k: t.get(k) for k in ("id", "title", "company", "status", "priority", "due", "agent") if t.get(k) is not None}


def call(name, a):
    if name == "lage":
        s = status()
        data = aos.load()
        today = dt.date.today().isoformat()
        focus = [short_task(t) for t in data["tasks"] if t.get("status") != "erledigt" and
                 (t.get("status") == "heute" or (t.get("due") or "9999") <= today)]
        s["fokus_aufgaben"] = focus[:20]
        return s
    if name == "aufgaben_liste":
        st = a.get("status") or "offen"
        comp = aos.company_for(a["bereich"]) if a.get("bereich") else None
        rows = [short_task(t) for t in aos.load()["tasks"]
                if (st == "offen" and t.get("status") != "erledigt" or t.get("status") == st)
                and (not comp or t.get("company") == comp)]
        return {"anzahl": len(rows), "aufgaben": rows[:100]}
    if name == "aufgabe_anlegen":
        data = aos.load()
        t = aos.parse(a["text"])
        t["source"] = os.environ.get("AOS_SOURCE", "mcp")
        if a.get("notiz"):
            t["notes"] = a["notiz"]
        data["tasks"].append(t)
        aos.save(data)
        return {"angelegt": short_task(t)}
    if name in ("aufgabe_erledigen", "aufgabe_verschieben"):
        data = aos.load()
        t = next((x for x in data["tasks"] if x.get("id") == a["id"]), None)
        if not t:
            return {"fehler": f"Aufgabe {a['id']} nicht gefunden"}
        aos.set_status(t, "erledigt" if name == "aufgabe_erledigen" else a["status"])
        if a.get("zusammenfassung"):
            t["notes"] = (t.get("notes", "") + "\n\n" if t.get("notes") else "") + a["zusammenfassung"]
        aos.save(data)
        return {"ok": True, "aufgabe": short_task(t)}
    if name == "agent_starten":
        cid = command("agent_starten", agent=a["agent"], auftrag=a["auftrag"], ordner=a.get("ordner"),
                      modus=a.get("modus", "autonom"), bereich=a.get("bereich"))
        return {"ok": True, "befehl": cid, "hinweis": "Agent wird im Salenta Code gestartet – Fortschritt mit laufende_agents prüfen."}
    if name == "laufende_agents":
        return {"agents": status().get("agents", [])}
    if name == "termine":
        days = int(a.get("tage") or 7)
        limit = (dt.datetime.now() + dt.timedelta(days=days)).isoformat()
        return {"termine": [e for e in status().get("termine", []) if (e.get("start") or "") <= limit]}
    if name == "mails":
        s = status()
        return {"ungelesen": s.get("mail_ungelesen"), "mails": s.get("mails", [])}
    if name == "seite_oeffnen":
        command("seite_oeffnen", seite=a["seite"])
        return {"ok": True}
    if name == "projekt_betreuer":
        command("betreuer_nachricht", ordner=a["ordner"], text=a["text"])
        return {"ok": True, "hinweis": "Beim Projekt-Betreuer angekommen. Er plant und meldet sich unter Coden › Projekt-Betreuer."}
    if name == "nachtschicht":
        command("nachtschicht_hinzufuegen", auftrag=a["auftrag"], ordner=a.get("ordner", ""), agent=a.get("agent", "auto"))
        return {"ok": True, "hinweis": "In der Nachtschicht-Warteschlange. Start: Seite Nachtschicht (oder heute Abend automatisch, wenn geplant)."}
    if name == "benachrichtigen":
        command("benachrichtigen", text=a["text"])
        return {"ok": True}
    if name == "freigabe":
        tool = a.get("tool_name", "")
        inp = a.get("input") or {}
        # Plan fertig: nicht auf eine Freigabe warten – Salenta Code zeigt den Plan mit „Plan umsetzen“.
        if tool == "ExitPlanMode":
            return {"behavior": "deny", "message": "Setze jetzt nichts um. Beende deine Arbeit mit deiner vollständigen Antwort als letzte Nachricht – "
                    "bei einer Frage die Antwort mit Datei:Zeile-Belegen, bei einem Plan den Plan mit nummerierten Schritten. Salenta Code zeigt sie dem Nutzer."}
        # Rückfragen gehen im Hintergrundmodus nicht interaktiv – in die Schlussantwort schreiben.
        if tool == "AskUserQuestion":
            return {"behavior": "deny", "message": "Rückfragen sind hier nicht interaktiv möglich. Triff eine sinnvolle Annahme und mach weiter; "
                    "schreib offene Fragen am Ende deiner Schlussantwort unter „Offen:“."}
        verdict, why = rule_check(tool, inp)
        if verdict == "block":
            log_auto(tool, {"blockiert": why})
            return {"behavior": "deny", "message": f"Durch eine Regel blockiert: {why}. Finde einen anderen Weg oder frag den Nutzer."}
        if verdict == "ask":
            ok, msg = ask_user(tool, dict(inp, _regel=why) if isinstance(inp, dict) else inp)
            if ok:
                return {"behavior": "allow", "updatedInput": inp}
            return {"behavior": "deny", "message": msg or "Abgelehnt."}
        # Browser- oder Computer-Steuerung: einmal fragen, für wie lange (15 Min., 1 Stunde, ganzer Tag) – gilt auch im Auto-Modus
        scope = control_scope(tool)
        if scope and not grant_active(scope):
            ok, msg = ask_user(tool, dict(inp, _zugriff=scope) if isinstance(inp, dict) else {"_zugriff": scope})
            if not ok or not grant_active(scope):
                return {"behavior": "deny", "message": msg or ("Browser-Steuerung nicht freigegeben. Mach ohne Browser weiter und nenne den Schritt am Ende."
                        if scope == "browser" else "Computer-Steuerung nicht freigegeben. Mach ohne sie weiter und nenne den Schritt am Ende.")}
        if needs_approval(tool, inp) and auto_mode():
            log_auto(tool, inp)
            return {"behavior": "allow", "updatedInput": inp}
        if needs_approval(tool, inp):
            ok, msg = ask_user(tool, inp)
        else:
            ok, msg = True, ""
        if ok:
            return {"behavior": "allow", "updatedInput": inp}
        return {"behavior": "deny", "message": msg or "Abgelehnt."}
    if name == "projekte_und_skills":
        s = status()
        q = (a.get("suche") or "").lower().split()
        def hit(*fields):
            text = " ".join(str(f) for f in fields).lower()
            return all(w in text for w in q) if q else True
        projekte = [p for p in s.get("projekte", []) if hit(p.get("name"), p.get("pfad"))]
        skills = [k for k in s.get("skills", []) if hit(k.get("name"), k.get("beschreibung"))] if q else \
            [{"name": k.get("name"), "quelle": k.get("quelle")} for k in s.get("skills", [])]
        return {"projekte": projekte[:80], "skills": skills[:120]}
    if name == "delegieren":
        me = os.environ.get("AOS_MISSION_ID")
        try:
            with open(os.path.join(DATA, "missions.json"), encoding="utf-8") as f:
                mine = next((m for m in json.load(f) if m.get("id") == me), None)
        except Exception:
            mine = None
        if mine and mine.get("delegated"):
            return {"fehler": "Du bist selbst ein Helfer – bitte nicht weiter delegieren, erledige den Teil selbst."}
        cid = command("agent_starten", agent=a["agent"], auftrag=a["auftrag"], ordner=a.get("ordner"), modus="autonom",
                      eltern=os.environ.get("AOS_MISSION_ID"), modell=a.get("modell") or None, denktiefe=a.get("denktiefe") or None)
        if a.get("warten", True) is False:
            return {"id": cid, "hinweis": "Läuft – Ergebnis mit ergebnis(id) abholen."}
        return delegation_result(cid, wait=840)
    if name == "ergebnis":
        return delegation_result(a["id"], wait=840 if a.get("warten") else 0)
    if name == "obsidian_suchen":
        v = vault()
        if not v:
            return {"fehler": "Kein Obsidian-Vault gefunden."}
        q = a["suche"].lower()
        words = [w for w in q.split() if len(w) > 1]
        hits = []
        for root, dirs, files in os.walk(v):
            dirs[:] = [d for d in dirs if not d.startswith(".")]
            for fn in files:
                if not fn.endswith(".md"):
                    continue
                fp = os.path.join(root, fn)
                try:
                    text = open(fp, encoding="utf-8", errors="ignore").read()
                except Exception:
                    continue
                low = text.lower()
                score = sum(low.count(w) for w in words) + (5 if q in fn.lower() else 0)
                if score:
                    i = max(0, low.find(words[0]) - 120) if words else 0
                    hits.append((score, os.path.relpath(fp, v), " ".join(text[i:i + 360].split())))
        hits.sort(key=lambda h: -h[0])
        n = int(a.get("max") or 12)
        return {"vault": v, "treffer": [{"pfad": p, "auszug": x} for _, p, x in hits[:n]]}
    if name == "obsidian_lesen":
        fp = vault_path(a["pfad"])
        text = open(fp, encoding="utf-8", errors="ignore").read()
        return {"pfad": a["pfad"], "inhalt": text[:40000]}
    if name == "obsidian_schreiben":
        text = a["text"]
        if any(k in text.lower() for k in SECRET):
            return {"fehler": "Sieht nach Zugangsdaten aus – wird nicht in den Vault geschrieben."}
        mode = a.get("modus") or "anhaengen"
        if mode == "journal":
            rel = os.path.join("Salenta Code", "Journal", dt.date.today().isoformat() + ".md")
            agent = os.environ.get("AOS_SOURCE", "Agent")
            text = f"\n## {dt.datetime.now():%H:%M} · {agent}\n{text.strip()}\n"
        else:
            rel = a.get("pfad") or ""
            if not rel.endswith(".md"):
                return {"fehler": "pfad muss eine .md-Datei im Vault sein"}
        fp = vault_path(rel)
        os.makedirs(os.path.dirname(fp), exist_ok=True)
        with open(fp, "w" if mode == "ersetzen" else "a", encoding="utf-8") as f:
            f.write(text if mode != "anhaengen" else "\n" + text.strip() + "\n")
        return {"ok": True, "pfad": rel}
    return {"fehler": f"Unbekanntes Tool {name}"}


def reply(msg_id, result=None, error=None):
    out = {"jsonrpc": "2.0", "id": msg_id}
    if error:
        out["error"] = {"code": -32000, "message": error}
    else:
        out["result"] = result
    sys.stdout.write(json.dumps(out, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except Exception:
            continue
        mid, method = msg.get("id"), msg.get("method")
        if mid is None:
            continue  # Notification
        try:
            if method == "initialize":
                reply(mid, {"protocolVersion": msg.get("params", {}).get("protocolVersion", "2025-06-18"),
                            "capabilities": {"tools": {}},
                            "serverInfo": {"name": "salenta-os", "version": "1.0"},
                            "instructions": "Salenta Code: Aufgaben, Termine, Mails, laufende Agents. Nutze 'lage' für den Überblick und 'agent_starten', um Claude Code, Codex oder Junie arbeiten zu lassen."})
            elif method == "tools/list":
                reply(mid, {"tools": TOOLS})
            elif method == "tools/call":
                p = msg.get("params", {})
                res = call(p.get("name"), p.get("arguments") or {})
                reply(mid, {"content": [{"type": "text", "text": json.dumps(res, ensure_ascii=False, indent=1)}],
                            "isError": "fehler" in res})
            elif method == "ping":
                reply(mid, {})
            else:
                reply(mid, error=f"Methode {method} nicht unterstützt")
        except Exception as e:  # noqa: BLE001
            reply(mid, error=str(e))


if __name__ == "__main__":
    main()
