WRITE_HINTS = ("senden", "send", "post", "publish", "delete", "loeschen", "löschen", "remove", "entfernen", "trash", "kauf",
               "buy", "order", "pay", "transfer", "create", "anlegen", "update", "aktualisieren", "setzen", "set_", "starten",
