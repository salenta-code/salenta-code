def status():
    try:
        with open(os.path.join(DATA, "status.json"), encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"hinweis": "Salenta Code läuft gerade nicht – Status nicht verfügbar."}


def command(kind, **payload):
    os.makedirs(DATA, exist_ok=True)
    payload.update({"id": str(uuid.uuid4()), "art": kind, "zeit": dt.datetime.now().astimezone().isoformat()})
    with open(os.path.join(DATA, "commands.jsonl"), "a", encoding="utf-8") as f:
        f.write(json.dumps(payload, ensure_ascii=False) + "\n")
    return payload["id"]


def vault():
    v = os.environ.get("AOS_VAULT") or status().get("obsidian_vault")
    return v if v and os.path.isdir(v) else None


def vault_path(rel):
    v = vault()
    if not v:
        raise ValueError("Kein Obsidian-Vault gefunden (Salenta Code muss einmal gelaufen sein).")
    full = os.path.realpath(os.path.join(v, rel))
    if not full.startswith(os.path.realpath(v) + os.sep):
        raise ValueError("Pfad liegt außerhalb des Vaults.")
    return full


SECRET = ("api_key", "apikey", "password", "passwort", "secret", "token=", "bearer ", "sk-")


READ_HINTS = ("lesen", "liste", "list", "get", "search", "suchen", "status", "ueberblick", "überblick", "read", "query",
