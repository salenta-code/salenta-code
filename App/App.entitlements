<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<!-- Gehärtete Laufzeit: nur was Salenta Code wirklich braucht -->
<key>com.apple.security.automation.apple-events</key><true/>   <!-- Apple Mail, Kalender, Terminal steuern -->
<key>com.apple.security.device.audio-input</key><true/>        <!-- Spracheingabe -->
<key>com.apple.security.device.camera</key><true/>             <!-- Videocalls in eingebetteten Web-Apps -->
<key>com.apple.security.personal-information.calendars</key><true/>
</dict></plist>
